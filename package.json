{
  "name": "shadowglass-website",
  "version": "1.0.0",
  "description": "Professional window tinting services website for ShadowGlass",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "npx live-server --port=3000 --open=index.html",
    "build": "echo 'Static site - no build process needed'",
    "lint": "npx eslint js/main.js",
    "format": "npx prettier --write .",
    "validate-html": "npx html-validate index.html",
    "lighthouse": "npx lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "test": "echo 'No tests specified'",
    "heroku-postbuild": "echo 'Post build completed'",
    "deploy": "./deploy-heroku.sh",
    "server": "node server.js",
    "local": "npm run server"
  },
  "keywords": [
    "window-tinting",
    "automotive",
    "professional-services",
    "responsive-design",
    "modern-web",
    "heroku"
  ],
  "author": "ShadowGlass Team",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^7.2.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "html-validate": "^8.0.0",
    "http-server": "^14.0.0",
    "lighthouse": "^11.0.0",
    "live-server": "^1.2.2",
    "prettier": "^3.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Haki3/shadow-glass.git"
  },
  "bugs": {
    "url": "https://github.com/Haki3/shadow-glass/issues"
  },
  "homepage": "https://shadowglass-website.herokuapp.com"
}
