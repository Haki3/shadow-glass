{
  "name": "shadowglass-website",
  "version": "1.0.0",
  "description": "Professional window tinting services website for ShadowGlass",
  "main": "index.html",
  "scripts": {
    "start": "npx http-server . -p 3000 -o",
    "dev": "npx live-server --port=3000 --open=index.html",
    "build": "echo 'Static site - no build process needed'",
    "lint": "npx eslint js/main.js",
    "format": "npx prettier --write .",
    "validate-html": "npx html-validate index.html",
    "lighthouse": "npx lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "test": "echo 'No tests specified'"
  },
  "keywords": [
    "window-tinting",
    "automotive",
    "professional-services",
    "responsive-design",
    "modern-web"
  ],
  "author": "ShadowGlass Team",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^8.0.0",
    "html-validate": "^8.0.0",
    "http-server": "^14.0.0",
    "lighthouse": "^11.0.0",
    "live-server": "^1.2.2",
    "prettier": "^3.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shadowglass/website.git"
  },
  "bugs": {
    "url": "https://github.com/shadowglass/website/issues"
  },
  "homepage": "https://shadowglass.es"
}
